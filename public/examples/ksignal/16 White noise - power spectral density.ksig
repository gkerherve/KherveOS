{
  "format": "ksig",
  "version": 1,
  "name": "White noise: power spectral density",
  "description": "Synthetic: white noise of standard deviation 0.1 plus a 1000 Hz sine of amplitude 0.5. Welch averaging (Hann, 50 % overlap) shows a flat floor at sigma^2 / (fs/2) = 2e-6 V^2/Hz = -57 dB/Hz, with the sine a narrow line about 35 dB above it. Averaging more segments (a shorter segment length) smooths the floor but widens the bins.",
  "synthetic": true,
  "source": {
    "kind": "generator",
    "fs": 10000,
    "duration": 10,
    "components": [
      {
        "type": "sine",
        "amp": 0.5,
        "freq": 1000,
        "phase": 0,
        "duty": 0.5,
        "f0": 100,
        "f1": 1000,
        "sweep": "linear",
        "carrier": 1000,
        "mod": 100,
        "depth": 0.5,
        "deviation": 200,
        "count": 8,
        "rolloff": 1,
        "tau": 0,
        "attack": 0,
        "partials": [],
        "bpm": 72,
        "variability": 0,
        "seed": 1,
        "center": 0.5,
        "width": 0.02
      }
    ],
    "noise": {
      "sigma": 0.1,
      "seed": 21,
      "color": "white"
    },
    "bits": 0,
    "fullScale": 1
  },
  "analysis": {
    "window": "hann",
    "beta": 8.6,
    "fftSize": 1024,
    "start": 0,
    "mode": "welch",
    "scale": "psd",
    "logFreq": false,
    "dbMin": -100,
    "dbMax": null,
    "fMax": null,
    "stftSize": 512,
    "overlap": 0.5,
    "compare": [],
    "analyse": "original",
    "peakRangeDb": 60,
    "maxPeaks": 10,
    "fundamental": 0,
    "timePeaks": {
      "enabled": false,
      "height": 0.5,
      "minDistance": 0.3
    },
    "specMin": -100,
    "specMax": null
  },
  "filter": {
    "family": "butter",
    "type": "lowpass",
    "order": 4,
    "f1": 1250,
    "f2": 2500,
    "rp": 1,
    "rs": 40,
    "window": "hamming",
    "beta": 8.6,
    "q": 30,
    "zeroPhase": false
  },
  "process": {
    "type": "none"
  },
  "tab": "spectrum",
  "cursors": {
    "a": null,
    "b": null
  }
}
