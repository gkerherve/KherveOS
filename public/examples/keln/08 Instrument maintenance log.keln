       "block": {
        "kind": "steps",
        "data": {
         "title": "Service steps",
         "items": [
          {
           "text": "Vent the load lock and inspect the seals",
           "doneBy": "Ana Martin",
           "doneAt": "2026-01-12T09:00:00"
          },
          {
           "text": "Replace the rotary pump oil",
           "doneBy": "Ana Martin",
           "doneAt": "2026-01-12T09:00:00"
          },
          {
           "text": "Replace the X-ray source filament",
           "doneBy": "Ana Martin",
           "doneAt": "2026-01-12T09:00:00"
          },
          {
           "text": "Bake the analysis chamber 24 h",
           "doneBy": "Ana Martin",
           "doneAt": "2026-01-12T09:00:00"
          },
          {
           "text": "Run the Au 4f / Ag 3d / Cu 2p calibration",
           "doneBy": "Ana Martin",
           "doneAt": "2026-01-12T09:00:00"
          }
         ]
        }
       }
