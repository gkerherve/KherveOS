   "id": "ent-006",
   "projectId": "prj-002",
   "experiment": "TFD-2026-001",
   "title": "Thickness vs power and annealing of the 200 W film",
   "date": "2026-04-24T15:00:00",
   "author": "Ana Martin",
   "tags": [
    "profilometry",
    "annealing"
   ],
   "status": "draft",
   "favourite": false,
   "content": {
    "type": "doc",
    "content": [
     {
      "type": "elnBlock",
      "attrs": {
       "block": {
        "kind": "instrument",
        "data": {
         "instrument": "Profilometer",
         "method": "Step height at a scratch",
         "operator": "Ana Martin",
         "started": "2026-04-24T14:00:00",
         "file": "",
         "path": "",
         "parameters": "2 mg stylus force, 5 scans per film",
         "notes": ""
        }
       }
      }
     },
     {
      "type": "elnBlock",
      "attrs": {
       "block": {
        "kind": "plot",
        "data": {
         "title": "Deposition rate",
         "xLabel": "Power (W)",
         "yLabel": "Rate (nm/s)",
         "kind": "line",
         "series": [
          "Rate"
         ],
         "rows": [
          [
           "100",
           "0.18"
          ],
          [
           "200",
           "0.37"
          ],
          [
           "300",
           "0.55"
          ]
         ]
        }
       }
      }
     },
     {
      "type": "paragraph",
      "content": [
       {
        "type": "text",
        "text": "The rate is linear in power ("
       },
       {
        "type": "mathInline",
        "attrs": {
         "latex": "R \\approx 1.8\\times 10^{-3}\\,P"
        }
       },
       {
        "type": "text",
        "text": " nm/s per W). "
       },
       {
        "type": "sampleMention",
        "attrs": {
         "id": "TF-0005",
         "label": "TF-0005"
        }
       },
       {
        "type": "text",
        "text": " was annealed from "
       },
       {
        "type": "sampleMention",
        "attrs": {
         "id": "TF-0003",
         "label": "TF-0003"
        }
       },
       {
        "type": "text",
        "text": ": sheet resistance fell from 0.42 to 0.31 Ω/sq."
       }
      ]
     }
    ]
   },
