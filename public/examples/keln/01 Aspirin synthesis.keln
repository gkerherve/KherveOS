  {
   "id": "ent-005",
   "projectId": "prj-002",
   "experiment": "ASP-2026-001",
   "title": "Recrystallisation and melting point",
   "date": "2026-02-10T09:00:00",
   "author": "Ana Martin",
   "tags": [
    "purification"
   ],
   "status": "draft",
   "favourite": false,
   "content": {
    "type": "doc",
    "content": [
     {
      "type": "heading",
      "attrs": {
       "level": 2
      },
      "content": [
       {
        "type": "text",
        "text": "Procedure"
       }
      ]
     },
     {
      "type": "orderedList",
      "content": [
       {
        "type": "listItem",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "type": "text",
            "text": "Dissolve the crude aspirin in the minimum hot ethanol (about 8 mL)."
           }
          ]
         }
        ]
       },
       {
        "type": "listItem",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "type": "text",
            "text": "Add warm water until cloudy, reheat to clear, cool slowly."
           }
          ]
         }
        ]
       },
       {
        "type": "listItem",
        "content": [
         {
          "type": "paragraph",
          "content": [
           {
            "type": "text",
            "text": "Filter, wash with ice-cold 1:1 ethanol/water, dry overnight."
           }
          ]
         }
        ]
       }
      ]
     },
     {
      "type": "elnBlock",
      "attrs": {
       "block": {
        "kind": "measurements",
        "data": {
         "title": "Melting point",
         "columns": [
          {
           "name": "Sample",
           "unit": ""
          },
          {
           "name": "Onset",
           "unit": "°C"
          },
          {
           "name": "Clear point",
           "unit": "°C"
          }
         ],
         "rows": [
          [
           "Crude",
           "133",
           "136"
          ],
          [
           "Recrystallised",
           "135",
           "136.5"
          ],
          [
           "Literature",
           "135",
           "136"
          ]
         ]
        }
       }
      }
     },
     {
      "type": "paragraph",
      "content": [
       {
        "type": "text",
        "text": "The recrystallised material melts sharply at the literature value. Recovery: 1.78 g from 2.12 g (84 %)."
       }
      ]
     }
    ]
   },
