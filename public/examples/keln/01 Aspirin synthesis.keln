 "entries": [
  {
   "id": "ent-004",
   "projectId": "prj-002",
   "experiment": "ASP-2026-001",
   "title": "Synthesis of acetylsalicylic acid",
   "date": "2026-02-09T09:30:00",
   "author": "Ana Martin",
   "tags": [
    "synthesis",
    "teaching",
    "esterification",
    "yield"
   ],
   "status": "draft",
   "favourite": false,
   "content": {
    "type": "doc",
    "content": [
     {
      "type": "heading",
      "attrs": {
       "level": 2
      },
      "content": [
       {
        "type": "text",
        "text": "Aim"
       }
      ]
     },
     {
      "type": "paragraph",
      "content": [
       {
        "type": "text",
        "text": "Acetylate salicylic acid with acetic anhydride (sulfuric acid as catalyst) to give aspirin, and determine the percentage yield."
       }
      ]
     },
     {
      "type": "heading",
      "attrs": {
       "level": 2
      },
      "content": [
       {
        "type": "text",
        "text": "Reaction"
       }
      ]
     },
     {
      "type": "elnBlock",
      "attrs": {
       "block": {
        "kind": "reaction",
        "data": {
         "title": "Salicylic acid + acetic anhydride",
         "smiles": "OC(=O)c1ccccc1O.CC(=O)OC(C)=O>>CC(=O)Oc1ccccc1C(O)=O.CC(O)=O",
         "notes": "Acetic anhydride in excess (about 3.7 equiv) drives the reaction.",
         "reagents": [
          {
           "name": "Salicylic acid",
           "formula": "C7H6O3",
           "mw": null,
           "role": "reactant",
           "coef": 1,
           "mass": 2,
           "volume": null,
           "density": null,
           "mmol": null,
           "purity": null,
           "actual": null,
           "cas": "69-72-7"
          },
          {
           "name": "Acetic anhydride",
           "formula": "C4H6O3",
           "mw": null,
           "role": "reactant",
           "coef": 1,
           "mass": null,
           "volume": 5,
           "density": 1.082,
           "mmol": null,
           "purity": null,
           "actual": null,
           "cas": "108-24-7"
          },
          {
           "name": "Sulfuric acid, 96 %",
           "formula": "H2SO4",
           "mw": null,
           "role": "catalyst",
           "coef": 1,
           "mass": null,
           "volume": 0.1,
           "density": 1.84,
           "mmol": null,
           "purity": null,
           "actual": null,
           "cas": "7664-93-9"
          },
          {
           "name": "Aspirin (crude)",
           "formula": "C9H8O4",
           "mw": null,
           "role": "product",
           "coef": 1,
           "mass": null,
           "volume": null,
           "density": null,
           "mmol": null,
           "purity": null,
           "actual": 2.12
          },
          {
           "name": "Acetic acid",
           "formula": "C2H4O2",
           "mw": null,
           "role": "product",
           "coef": 1,
           "mass": null,
           "volume": null,
           "density": null,
           "mmol": null,
           "purity": null,
           "actual": null
          }
         ]
        }
       }
      }
     },
     {
      "type": "heading",
      "attrs": {
       "level": 2
      },
      "content": [
       {
        "type": "text",
        "text": "Safety"
       }
      ]
     },
     {
      "type": "elnBlock",
      "attrs": {
       "block": {
        "kind": "safety",
        "data": {
         "hazards": [
          "Acetic anhydride: corrosive, lachrymator",
          "Sulfuric acid: severe burns"
         ],
         "ppe": [
          "Lab coat",
          "Goggles",
          "Nitrile gloves",
          "Fume hood"
         ],
         "pictograms": [
          "Corrosive",
          "Flammable"
         ],
         "controls": "Add the acid dropwise; work in the hood",
         "waste": "Aqueous filtrate to the acidic aqueous waste",
         "risk": "medium"
        }
       }
      }
     },
     {
      "type": "heading",
      "attrs": {
       "level": 2
      },
      "content": [
       {
        "type": "text",
        "text": "Procedure"
       }
      ]
     },
     {
      "type": "elnBlock",
      "attrs": {
       "block": {
        "kind": "steps",
        "data": {
         "title": "Procedure",
         "items": [
          {
           "text": "Weigh 2.00 g of salicylic acid into a 50 mL Erlenmeyer flask",
           "doneBy": "Ana Martin",
           "doneAt": "2026-02-09T09:40:00"
          },
          {
           "text": "Add 5.0 mL acetic anhydride and 5 drops of concentrated sulfuric acid (fume hood)",
           "doneBy": "Ana Martin",
           "doneAt": "2026-02-09T09:48:00"
          },
          {
           "text": "Warm in a water bath at 75 °C for 15 min, swirling",
           "doneBy": "Ana Martin",
           "doneAt": "2026-02-09T10:05:00"
          },
          {
           "text": "Cool, add 20 mL cold water slowly, then chill in an ice bath",
           "doneBy": "Ana Martin",
           "doneAt": "2026-02-09T10:30:00"
          },
          {
           "text": "Filter on a Buchner funnel and wash with cold water",
           "doneBy": "Ana Martin",
           "doneAt": "2026-02-09T10:50:00"
          }
         ]
        }
       }
      }
     },
     {
      "type": "elnBlock",
      "attrs": {
       "block": {
        "kind": "timeline",
        "data": {
         "title": "Observations",
         "items": [
          {
           "time": "2026-02-09T09:52:00",
           "text": "Solid dissolved on warming; faint yellow tint."
          },
          {
           "time": "2026-02-09T10:22:00",
           "text": "White needles started to crystallise on cooling."
          },
          {
           "time": "2026-02-09T11:10:00",
           "text": "Dry crude product: white crystalline solid, 2.12 g."
          }
         ]
        }
       }
      }
     },
     {
      "type": "heading",
      "attrs": {
       "level": 2
      },
      "content": [
       {
        "type": "text",
        "text": "Characterisation"
       }
      ]
     },
     {
      "type": "elnBlock",
      "attrs": {
       "block": {
        "kind": "instrument",
        "data": {
         "instrument": "FTIR (ATR)",
         "method": "ATR, 32 scans, 4 cm-1",
         "operator": "Ana Martin",
         "started": "2026-02-09T14:15:00",
         "file": "att-003",
         "path": "",
         "parameters": "",
         "notes": "No broad phenol O-H near 3200 cm-1: the starting material is consumed."
        }
       }
      }
     },
     {
      "type": "paragraph",
      "content": [
       {
        "type": "text",
        "text": "IR peaks are in the attached file ("
       },
       {
        "type": "text",
        "text": "aspirin-ir-peaks.csv",
        "marks": [
         {
          "type": "link",
          "attrs": {
           "href": "keln-att:att-003"
          }
         }
        ]
       },
       {
        "type": "text",
        "text": "). Melting point of the crude product: 133-136 °C (literature 136 °C)."
       }
      ]
     },
     {
      "type": "heading",
      "attrs": {
       "level": 2
      },
      "content": [
       {
        "type": "text",
        "text": "Yield"
       }
      ]
     },
     {
      "type": "paragraph",
      "content": [
       {
        "type": "text",
        "text": "The reaction table gives the theoretical yield from the limiting reagent (salicylic acid): 2.61 g. Isolated: 2.12 g, so about 81 %. Losses: transfers and the mother liquor."
       }
      ]
     }
    ]
   },
