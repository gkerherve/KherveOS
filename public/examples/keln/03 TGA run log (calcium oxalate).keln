       {
        "type": "text",
        "text": "CO2 loss of 8.8 % corresponds to "
       },
       {
        "type": "mathInline",
        "attrs": {
         "latex": "8.8 \\times \\frac{100.09}{44.01} = 20.0\\ \\%"
        }
       },
       {
        "type": "text",
        "text": " CaCO3: the filler content is 20 wt%, as compounded."
       }
      ]
