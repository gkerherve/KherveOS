 "entries": [
  {
   "id": "ent-003",
   "projectId": "prj-002",
   "experiment": "SOL-2026-001",
   "title": "0.1 mol/L NaOH, 500 mL",
   "date": "2026-02-23T09:15:00",
   "author": "Ana Martin",
   "tags": [
    "solution",
    "base"
   ],
   "status": "draft",
   "favourite": false,
   "content": {
    "type": "doc",
    "content": [
     {
      "type": "heading",
      "attrs": {
       "level": 2
      },
      "content": [
       {
        "type": "text",
        "text": "Target"
       }
      ]
     },
     {
      "type": "paragraph",
      "content": [
       {
        "type": "text",
        "text": "500 mL of 0.1 mol/L NaOH: "
       },
       {
        "type": "mathInline",
        "attrs": {
         "latex": "m = c\\,V\\,M = 0.1 \\times 0.500 \\times 40.00 = 2.000\\ \\mathrm{g}"
        }
       },
       {
        "type": "text",
        "text": "."
       }
      ]
     },
     {
      "type": "elnBlock",
      "attrs": {
       "block": {
        "kind": "materials",
        "data": {
         "title": "Materials",
         "items": [
          {
           "name": "Sodium hydroxide, pellets",
           "cas": "1310-73-2",
           "supplier": "Merck",
           "lot": "",
           "amount": "2.00 g",
           "hazard": "Corrosive"
          },
          {
           "name": "Water, deionised",
           "cas": "7732-18-5",
           "supplier": "",
           "lot": "",
           "amount": "to 500 mL",
           "hazard": ""
          }
         ]
        }
       }
      }
     },
     {
      "type": "elnBlock",
      "attrs": {
       "block": {
        "kind": "steps",
        "data": {
         "title": "Preparation",
         "items": [
          {
           "text": "Weigh 2.00 g NaOH quickly (hygroscopic)",
           "doneBy": "Ana Martin",
           "doneAt": "2026-02-23T09:25:00"
          },
          {
           "text": "Dissolve in about 400 mL boiled, cooled water",
           "doneBy": "Ana Martin",
           "doneAt": "2026-02-23T09:35:00"
          },
          {
           "text": "Make up to 500 mL, mix, store in a PE bottle",
           "doneBy": "Ana Martin",
           "doneAt": "2026-02-23T09:50:00"
          }
         ]
        }
       }
      }
     },
     {
      "type": "paragraph",
      "content": [
       {
        "type": "text",
        "text": "Standardise against KHP before use (see the titration notebook); the true concentration is typically 0.098 mol/L because NaOH absorbs CO"
       },
       {
        "type": "text",
        "text": "2",
        "marks": [
         {
          "type": "subscript"
         }
        ]
       },
       {
        "type": "text",
        "text": " and water."
       }
      ]
     }
    ]
   },
