     "reason": "Transposed digits in the pH readings",
     "content": {
      "type": "doc",
      "content": [
       {
        "type": "paragraph",
        "content": [
         {
          "type": "text",
          "text": "Correction: the pH readings were mistyped. The correct readings are "
         },
         {
          "type": "text",
          "text": "7.38, 7.39, 7.38",
          "marks": [
           {
            "type": "bold"
           }
          ]
         },
         {
          "type": "text",
          "text": " (digits transposed); the buffer is at the target pH 7.4. The signed text above is left as written."
         }
        ]
       }
      ]
     },
