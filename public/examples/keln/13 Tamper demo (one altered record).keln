  {
   "id": "ent-005",
   "projectId": "prj-002",
   "experiment": "DEM-2026-002",
   "title": "Crystal growth of CuSO4 from solution",
   "date": "2026-06-02T10:00:00",
   "author": "Ana Martin",
   "tags": [
    "crystals",
    "signed"
   ],
   "status": "signed",
   "favourite": false,
   "content": {
    "type": "doc",
    "content": [
     {
      "type": "paragraph",
      "content": [
       {
        "type": "text",
        "text": "Saturated CuSO"
       },
       {
        "type": "text",
        "text": "4",
        "marks": [
         {
          "type": "subscript"
         }
        ]
       },
       {
        "type": "text",
        "text": " solution at 40 °C cooled slowly to room temperature over 48 h. Blue triclinic crystals up to 6 mm."
       }
      ]
     },
     {
      "type": "elnBlock",
      "attrs": {
       "block": {
        "kind": "timeline",
        "data": {
         "title": "Observations",
         "items": [
          {
           "time": "2026-06-02T10:30:00",
           "text": "Seed crystal added."
          },
          {
           "time": "2026-06-03T10:30:00",
           "text": "Crystals visible, 2 mm."
          },
          {
           "time": "2026-06-04T10:30:00",
           "text": "Harvested; 6 mm largest."
          }
         ]
        }
       }
      }
     }
    ]
   },
