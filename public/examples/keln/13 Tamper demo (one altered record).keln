  {
   "id": "ent-003",
   "projectId": "prj-002",
   "experiment": "DEM-2026-001",
   "title": "Preparation of 50 mmol/L phosphate buffer, pH 7.4",
   "date": "2026-06-01T09:00:00",
   "author": "Ana Martin",
   "tags": [
    "buffer",
    "signed"
   ],
   "status": "witnessed",
   "favourite": false,
   "content": {
    "type": "doc",
    "content": [
     {
      "type": "heading",
      "attrs": {
       "level": 2
      },
      "content": [
       {
        "type": "text",
        "text": "Procedure"
       }
      ]
     },
     {
      "type": "paragraph",
      "content": [
       {
        "type": "text",
        "text": "Dissolved 0.69 g NaH"
       },
       {
        "type": "text",
        "text": "2",
        "marks": [
         {
          "type": "subscript"
         }
        ]
       },
       {
        "type": "text",
        "text": "PO"
       },
       {
        "type": "text",
        "text": "4",
        "marks": [
         {
          "type": "subscript"
         }
        ]
       },
       {
        "type": "text",
        "text": " and 3.55 g Na"
       },
       {
        "type": "text",
        "text": "2",
        "marks": [
         {
          "type": "subscript"
         }
        ]
       },
       {
        "type": "text",
        "text": "HPO"
       },
       {
        "type": "text",
        "text": "4",
        "marks": [
         {
          "type": "subscript"
         }
        ]
       },
       {
        "type": "text",
        "text": " in 900 mL water, adjusted to pH with HCl, made up to 1 L."
       }
      ]
     },
     {
      "type": "elnBlock",
      "attrs": {
       "block": {
        "kind": "instrument",
        "data": {
         "instrument": "pH meter (Mettler SevenCompact)",
         "method": "Calibrated at pH 4.01 / 7.00 / 10.01 the same morning",
         "operator": "Ana Martin",
         "started": "2026-06-01T09:20:00",
         "file": "",
         "path": "",
         "parameters": "",
         "notes": ""
        }
       }
      }
     },
     {
      "type": "elnBlock",
      "attrs": {
       "block": {
        "kind": "measurements",
        "data": {
         "title": "pH check",
         "columns": [
          {
           "name": "Reading",
           "unit": "pH"
          }
         ],
         "rows": [
          [
           "7.83"
          ],
          [
           "7.84"
          ],
          [
           "7.83"
          ]
         ]
        }
       }
      }
     }
    ]
   },
