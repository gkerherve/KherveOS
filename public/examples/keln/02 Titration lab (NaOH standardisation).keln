    "food"
   ],
   "status": "draft",
   "favourite": false,
   "content": {
    "type": "doc",
    "content": [
     {
      "type": "heading",
      "attrs": {
       "level": 2
      },
      "content": [
       {
        "type": "text",
        "text": "Method"
       }
      ]
     },
     {
      "type": "paragraph",
      "content": [
       {
        "type": "text",
        "text": "10.00 mL of vinegar diluted to 100.0 mL; 25.00 mL aliquots titrated with the standardised NaOH from "
       },
       {
        "type": "text",
        "text": "TIT-2026-001",
        "marks": [
         {
          "type": "italic"
         }
        ]
       },
       {
        "type": "text",
        "text": "."
       }
      ]
     },
     {
      "type": "elnBlock",
      "attrs": {
       "block": {
        "kind": "measurements",
        "data": {
         "title": "Vinegar aliquots",
         "columns": [
          {
           "name": "Run",
           "unit": ""
          },
          {
           "name": "Titre",
           "unit": "mL"
          }
         ],
         "rows": [
          [
           "1",
           "17.85"
          ],
          [
           "2",
           "17.90"
          ],
          [
           "3",
           "17.80"
          ]
         ]
        }
       }
      }
     },
     {
      "type": "paragraph",
      "content": [
       {
        "type": "text",
        "text": "Mean titre 17.85 mL → acetic acid "
       },
       {
        "type": "mathInline",
        "attrs": {
         "latex": "\\approx 4.5\\ \\%\\ (m/V)"
        }
       },
       {
        "type": "text",
        "text": ", matching the label (4.5 %)."
       }
      ]
     }
    ]
