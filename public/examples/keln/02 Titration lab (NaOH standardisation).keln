 "entries": [
  {
   "id": "ent-003",
   "projectId": "prj-002",
   "experiment": "TIT-2026-001",
   "title": "Standardisation of NaOH with potassium hydrogen phthalate",
   "date": "2026-03-02T09:00:00",
   "author": "Ana Martin",
   "tags": [
    "titration",
    "standardisation"
   ],
   "status": "draft",
   "favourite": false,
   "content": {
    "type": "doc",
    "content": [
     {
      "type": "heading",
      "attrs": {
       "level": 2
      },
      "content": [
       {
        "type": "text",
        "text": "Aim"
       }
      ]
     },
     {
      "type": "paragraph",
      "content": [
       {
        "type": "text",
        "text": "Find the exact concentration of the ~0.1 mol/L NaOH solution with the primary standard KHP ("
       },
       {
        "type": "mathInline",
        "attrs": {
         "latex": "M = 204.22\\ \\mathrm{g/mol}"
        }
       },
       {
        "type": "text",
        "text": ")."
       }
      ]
     },
     {
      "type": "heading",
      "attrs": {
       "level": 2
      },
      "content": [
       {
        "type": "text",
        "text": "Solutions"
       }
      ]
     },
     {
      "type": "elnBlock",
      "attrs": {
       "block": {
        "kind": "materials",
        "data": {
         "title": "Solutions",
         "items": [
          {
           "name": "NaOH (about 0.1 mol/L)",
           "cas": "1310-73-2",
           "supplier": "prepared 2026-02-27",
           "lot": "",
           "amount": "burette",
           "hazard": "Corrosive"
          },
          {
           "name": "Potassium hydrogen phthalate (KHP)",
           "cas": "877-24-7",
           "supplier": "Merck, primary standard",
           "lot": "HC27481",
           "amount": "0.5 g per run",
           "hazard": ""
          },
          {
           "name": "Phenolphthalein, 1 %",
           "cas": "77-09-8",
           "supplier": "",
           "lot": "",
           "amount": "2 drops",
           "hazard": ""
          }
         ]
        }
       }
      }
     },
     {
      "type": "heading",
      "attrs": {
       "level": 2
      },
      "content": [
       {
        "type": "text",
        "text": "Results"
       }
      ]
     },
     {
      "type": "elnBlock",
      "attrs": {
       "block": {
        "kind": "measurements",
        "data": {
         "title": "KHP titrations",
         "columns": [
          {
           "name": "Run",
           "unit": ""
          },
          {
           "name": "m(KHP)",
           "unit": "g"
          },
          {
           "name": "Titre of NaOH",
           "unit": "mL"
          },
          {
           "name": "c(NaOH)",
           "unit": "mol/L"
          }
         ],
         "rows": [
          [
           "1",
           "0.5106",
           "24.92",
           "0.1003"
          ],
          [
           "2",
           "0.5231",
           "25.55",
           "0.1003"
          ],
          [
           "3",
           "0.5017",
           "24.51",
           "0.1002"
          ]
         ]
        }
       }
      }
     },
     {
      "type": "paragraph",
      "content": [
       {
        "type": "text",
        "text": "Each run: "
       },
       {
        "type": "mathInline",
        "attrs": {
         "latex": "c_{\\mathrm{NaOH}} = \\frac{m_{\\mathrm{KHP}}}{M_{\\mathrm{KHP}}\\,V_{\\mathrm{NaOH}}}"
        }
       },
       {
        "type": "text",
        "text": ". Run 2 used a slightly larger sample. The three results agree to 0.5 %."
       }
      ]
     },
     {
      "type": "elnBlock",
      "attrs": {
       "block": {
        "kind": "plot",
        "data": {
         "title": "Concentration by run",
         "xLabel": "Run",
         "yLabel": "c(NaOH) (mol/L)",
         "kind": "scatter",
         "series": [
          "c"
         ],
         "rows": [
          [
           "1",
           "0.1003"
          ],
          [
           "2",
           "0.1003"
          ],
          [
           "3",
           "0.1002"
          ]
         ]
        }
       }
      }
     },
     {
      "type": "heading",
      "attrs": {
       "level": 2
      },
      "content": [
       {
        "type": "text",
        "text": "Comparison with the simulator"
       }
      ]
     },
     {
      "type": "paragraph",
      "content": [
       {
        "type": "text",
        "text": "Open the kTitration examples (link on the right) for the full pH curve of this titration: the equivalence point near pH 8.7 matches the phenolphthalein end point."
       }
      ]
     }
    ]
   },
