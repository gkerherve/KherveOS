        "props": {
          "delay": ""
        }
      },
      {
        "id": "p5",
        "kind": "led",
        "ref": "LED1",
        "x": 620,
        "y": 100,
        "rot": 0,
        "mirror": false,
        "props": {
          "color": "green",
          "name": "OUT"
