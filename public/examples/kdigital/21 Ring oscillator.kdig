{
  "format": "kdig",
  "version": 1,
  "name": "Ring oscillator",
  "description": "A NAND and two inverters in a loop. With EN = 0 the loop is held; with EN = 1 it oscillates — the simulator notices and tells you.",
  "tab": "circuit",
  "circuit": {
    "parts": [
      {
        "id": "p1",
        "kind": "switch",
        "ref": "SW1",
        "x": 0,
        "y": 100,
        "rot": 0,
        "mirror": false,
        "props": {
          "name": "EN",
          "value": "0"
        }
      },
      {
        "id": "p2",
        "kind": "nand",
        "ref": "U1",
        "x": 140,
        "y": 100,
        "rot": 0,
        "mirror": false,
        "props": {
          "delay": "",
          "inputs": "2"
        }
      },
      {
