    ],
    "notes": [
      {
        "id": "n1",
        "text": "Ring oscillator: three inversions in a loop never settle.",
        "x": 0,
        "y": 20
      },
      {
        "id": "n2",
        "text": "Set EN = 1: the loop oscillates with period 6 gate delays (kDigital reports the oscillation).",
        "x": 0,
        "y": 215
      }
    ]
  },
  "stimulus": [
    {
      "t": 0,
      "set": {
        "EN": 0
      }
    },
    {
      "t": 30,
      "set": {
        "EN": 1
      }
    }
  ],
  "until": 200,
  "probes": [
