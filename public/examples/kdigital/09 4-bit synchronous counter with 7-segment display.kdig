    "notes": [
      {
        "id": "n1",
        "text": "4-bit synchronous counter from T flip-flops: T0=1, T1=Q0, T2=Q0·Q1, T3=Q0·Q1·Q2",
        "x": 0,
        "y": -50
      },
      {
        "id": "n2",
        "text": "All flip-flops share CLK; RST clears them.",
        "x": 0,
        "y": 620
      }
    ]
