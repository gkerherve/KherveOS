    },
    {
      "objects": [
        {
          "x": 0.06,
          "y": 0.22,
          "w": 0.88,
          "h": 0.06,
          "text": "By the end of this lecture you can:",
          "font_pt": 17,
          "font_family": "",
          "color": "#000000",
          "fill": "",
          "fill2": "",
          "gradient": "vertical",
          "align": "left",
          "bold": false,
          "italic": false,
          "border_color": "",
          "border_width": 1.0,
          "corner": "sharp",
          "border_style": "solid",
          "fill_opacity": 1.0,
          "shadow": false,
          "corner_radius": 4.0,
          "locked": false,
          "block": "",
          "block_title": "",
          "group": 0,
          "type": "SlideText"
        },
        {
          "x": 0.06,
          "y": 0.3,
          "w": 0.88,
          "h": 0.5,
          "text": "\\begin{itemize}\n\\item State the first law of thermodynamics\n\\item Tell work from heat\n\\begin{itemize}\n\\item sign conventions\n\\item path dependence\n\\end{itemize}\n\\item Apply it to ideal-gas processes\n\\end{itemize}",
          "font_pt": 18,
          "font_family": "",
          "color": "#000000",
          "fill": "",
          "fill2": "",
          "gradient": "vertical",
          "align": "left",
          "bold": false,
          "italic": false,
          "border_color": "",
          "border_width": 1.0,
          "corner": "sharp",
          "border_style": "solid",
          "fill_opacity": 1.0,
          "shadow": false,
          "corner_radius": 4.0,
          "locked": false,
          "block": "",
          "block_title": "",
          "group": 0,
          "type": "SlideText"
        }
      ],
      "title": "Learning objectives",
      "bg": "",
      "bg_alpha": 1.0,
      "free": true,
      "type": "Slide",
      "hidden": false
    },
    {
      "objects": [
        {
          "x": 0.06,
          "y": 0.22,
          "w": 0.88,
          "h": 0.1,
          "text": "The internal energy $U$ of a system is a state function.",
          "font_pt": 15,
          "font_family": "",
          "color": "#000000",
          "fill": "",
          "fill2": "",
          "gradient": "vertical",
          "align": "left",
          "bold": false,
          "italic": false,
          "border_color": "",
          "border_width": 1.0,
          "corner": "sharp",
          "border_style": "solid",
          "fill_opacity": 1.0,
          "shadow": false,
          "corner_radius": 4.0,
          "locked": false,
          "block": "definition",
          "block_title": "",
          "group": 0,
          "type": "SlideText"
        },
        {
          "x": 0.06,
          "y": 0.42,
          "w": 0.88,
          "h": 0.14,
          "text": "For any process, the change in internal energy equals the heat added minus the work done by the system.",
          "font_pt": 15,
          "font_family": "",
          "color": "#000000",
          "fill": "",
          "fill2": "",
          "gradient": "vertical",
          "align": "left",
          "bold": false,
          "italic": false,
          "border_color": "",
          "border_width": 1.0,
          "corner": "sharp",
          "border_style": "solid",
          "fill_opacity": 1.0,
          "shadow": false,
          "corner_radius": 4.0,
          "locked": false,
          "block": "theorem",
          "block_title": "First law",
          "group": 0,
          "type": "SlideText"
        },
        {
          "x": 0.25,
          "y": 0.66,
          "w": 0.5,
          "h": 0.12,
          "text": "\\[\\Delta U = Q - W\\]",
          "font_pt": 30,
          "font_family": "",
          "color": "#000000",
          "fill": "",
          "fill2": "",
          "gradient": "vertical",
          "align": "center",
          "bold": false,
          "italic": false,
          "border_color": "",
          "border_width": 1.0,
          "corner": "sharp",
          "border_style": "solid",
          "fill_opacity": 1.0,
          "shadow": false,
          "corner_radius": 4.0,
          "locked": false,
          "block": "",
          "block_title": "",
          "group": 0,
          "type": "SlideText"
        }
      ],
      "title": "The first law",
      "bg": "",
      "bg_alpha": 1.0,
      "free": true,
      "type": "Slide",
      "hidden": false
    },
    {
      "objects": [
        {
          "x": 0.04,
          "y": 0.22,
          "w": 0.42,
          "h": 0.3,
          "text": "One mole of ideal gas expands isothermally at 300 K from 10 L to 20 L. Find $Q$ and $W$.",
          "font_pt": 14,
          "font_family": "",
          "color": "#000000",
          "fill": "",
          "fill2": "",
          "gradient": "vertical",
          "align": "left",
          "bold": false,
          "italic": false,
          "border_color": "",
          "border_width": 1.0,
          "corner": "sharp",
          "border_style": "solid",
          "fill_opacity": 1.0,
          "shadow": false,
          "corner_radius": 4.0,
          "locked": false,
          "block": "block",
          "block_title": "Problem",
          "group": 0,
          "type": "SlideText"
        },
        {
          "x": 0.5,
          "y": 0.22,
          "w": 0.46,
          "h": 0.5,
          "text": "\\begin{enumerate}\n\\item Isothermal: $\\Delta U = 0$, so $Q = W$\n\\item $W = nRT\\ln(V_2/V_1)$\n\\item $W = 8.314 \\times 300 \\times \\ln 2$\n\\item $W = Q \\approx 1.73$ kJ\n\\end{enumerate}",
          "font_pt": 15,
          "font_family": "",
          "color": "#000000",
          "fill": "",
          "fill2": "",
          "gradient": "vertical",
          "align": "left",
          "bold": false,
          "italic": false,
          "border_color": "",
          "border_width": 1.0,
          "corner": "sharp",
          "border_style": "solid",
          "fill_opacity": 1.0,
          "shadow": false,
          "corner_radius": 4.0,
          "locked": false,
          "block": "",
          "block_title": "",
          "group": 0,
          "type": "SlideText"
        },
        {
          "x": 0.04,
          "y": 0.6,
          "w": 0.42,
          "h": 0.15,
          "text": "\\[W=\\int_{V_1}^{V_2} p\\,dV\\]",
          "font_pt": 20,
          "font_family": "",
          "color": "#000000",
          "fill": "",
          "fill2": "",
          "gradient": "vertical",
          "align": "center",
          "bold": false,
          "italic": false,
          "border_color": "",
          "border_width": 1.0,
          "corner": "sharp",
          "border_style": "solid",
          "fill_opacity": 1.0,
          "shadow": false,
          "corner_radius": 4.0,
          "locked": false,
          "block": "",
          "block_title": "",
          "group": 0,
          "type": "SlideText"
        }
      ],
      "title": "Worked example",
      "bg": "",
      "bg_alpha": 1.0,
      "free": true,
      "type": "Slide",
      "hidden": false
    },
