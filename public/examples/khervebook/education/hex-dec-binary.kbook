29\": \"27\", \"B29\": \"11011\", \"C29\": \"33\", \"D29\": \"1B\", \"A30\": \"28\", \"B30\": \"11100\", \"C30\": \"34\", \"D30\": \"1C\", \"A31\": \"29\", \"B31\": \"11101\", \"C31\": \"35\", \"D31\": \"1D\", \"A32\": \"30\", \"B32\": \"11110\", \"C32\": \"36\", \"D32\": \"1E\", \"A33\": \"31\", \"B33\": \"11111\", \"C33\": \"37\", \"D33\": \"1F\", \"A34\": \"32\", \"B34\": \"100000\", \"C34\": \"40\", \"D34\": \"20\", \"A35\": \"33\", \"B35\": \"100001\", \"C35\": \"41\", \"D35\": \"21\", \"A36\": \"34\", \"B36\": \"100010\", \"C36\": \"42\", \"D36\": \"22\", \"A37\": \"35\", \"B37\": \"100011\", \"C37\": \"43\", \"D37\": \"23\", \"A38\": \"36\", \"B38\": \"100100\", \"C38\": \"44\", \"D38\": \"24\", \"A39\": \"37\", \"B39\": \"100101\", \"C39\": \"45\", \"D39\": \"25\", \"A40\": \"38\", \"B40\": \"100110\", \"C40\": \"46\", \"D40\": \"26\", \"A41\": \"39\", \"B41\": \"100111\", \"C41\": \"47\", \"D41\": \"27\", \"A42\": \"40\", \"B42\": \"101000\", \"C42\": \"50\", \"D42\": \"28\", \"A43\": \"41\", \"B43\": \"101001\", \"C43\": \"51\", \"D43\": \"29\", \"A44\": \"42\", \"B44\": \"101010\", \"C44\": \"52\", \"D44\": \"2A\", \"A45\": \"43\", \"B45\": \"101011\", \"C45\": \"53\", \"D45\": \"2B\", \"A46\": \"44\", \"B46\": \"101100\", \"C46\": \"54\", \"D46\": \"2C\", \"A47\": \"45\", \"B47\": \"101101\", \"C47\": \"55\", \"D47\": \"2D\", \"A48\": \"46\", \"B48\": \"101110\", \"C48\": \"56\", \"D48\": \"2E\", \"A49\": \"47\", \"B49\": \"101111\", \"C49\": \"57\", \"D49\": \"2F\", \"A50\": \"48\", \"B50\": \"110000\", \"C50\": \"60\", \"D50\": \"30\", \"A51\": \"49\", \"B51\": \"110001\", \"C51\": \"61\", \"D51\": \"31\", \"A52\": \"50\", \"B52\": \"110010\", \"C52\": \"62\", \"D52\": \"32\", \"A53\": \"51\", \"B53\": \"110011\", \"C53\": \"63\", \"D53\": \"33\", \"A54\": \"52\", \"B54\": \"110100\", \"C54\": \"64\", \"D54\": \"34\", \"A55\": \"53\", \"B55\": \"110101\", \"C55\": \"65\", \"D55\": \"35\", \"A56\": \"54\", \"B56\": \"110110\", \"C56\": \"66\", \"D56\": \"36\", \"A57\": \"55\", \"B57\": \"110111\", \"C57\": \"67\", \"D57\": \"37\", \"A58\": \"56\", \"B58\": \"111000\", \"C58\": \"70\", \"D58\": \"38\", \"A59\": \"57\", \"B59\": \"111001\", \"C59\": \"71\", \"D59\": \"39\", \"A60\": \"58\", \"B60\": \"111010\", \"C60\": \"72\", \"D60\": \"3A\", \"A61\": \"59\", \"B61\": \"111011\", \"C61\": \"73\", \"D61\": \"3B\", \"A62\": \"60\", \"B62\": \"111100\", \"C62\": \"74\", \"D62\": \"3C\", \"A63\": \"61\", \"B63\": \"111101\", \"C63\": \"75\", \"D63\": \"3D\", \"A64\": \"62\", \"B64\": \"111110\", \"C64\": \"76\", \"D64\": \"3E\", \"A65\": \"63\", \"B65\": \"111111\", \"C65\": \"77\", \"D65\": \"3F\", \"A66\": \"64\", \"B66\": \"1000000\", \"C66\": \"100\", \"D66\": \"40\"}}], \"active\": \"NumBases\"}"
