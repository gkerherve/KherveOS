119.78\", \"L7\": \"536.62\", \"M7\": \"1075.23\", \"N7\": \"12521.25\", \"A8\": \"Entertainment\", \"B8\": \"421.66\", \"C8\": \"1101.43\", \"D8\": \"748.20\", \"E8\": \"288.45\", \"F8\": \"257.17\", \"G8\": \"369.56\", \"H8\": \"1447.08\", \"I8\": \"893.43\", \"J8\": \"883.12\", \"K8\": \"931.48\", \"L8\": \"1180.44\", \"M8\": \"1717.03\", \"N8\": \"10239.05\", \"A9\": \"Clothing\", \"B9\": \"907.22\", \"C9\": \"78.50\", \"D9\": \"242.08\", \"E9\": \"646.73\", \"F9\": \"1970.20\", \"G9\": \"1458.39\", \"H9\": \"1048.66\", \"I9\": \"1921.88\", \"J9\": \"499.19\", \"K9\": \"356.60\", \"L9\": \"550.09\", \"M9\": \"1329.76\", \"N9\": \"11009.30\", \"A10\": \"Healthcare\", \"B10\": \"1096.04\", \"C10\": \"390.51\", \"D10\": \"240.37\", \"E10\": \"889.13\", \"F10\": \"1046.68\", \"G10\": \"740.86\", \"H10\": \"1427.95\", \"I10\": \"1143.99\", \"J10\": \"1220.27\", \"K10\": \"533.90\", \"L10\": \"890.77\", \"M10\": \"571.95\", \"N10\": \"10192.42\", \"A11\": \"Savings\", \"B11\": \"1981.95\", \"C11\": \"1650.68\", \"D11\": \"1283.16\", \"E11\": \"1339.82\", \"F11\": \"765.15\", \"G11\": \"639.12\", \"H11\": \"103.94\", \"I11\": \"302.66\", \"J11\": \"1756.81\", \"K11\": \"1429.33\", \"L11\": \"1001.99\", \"M11\": \"1801.13\", \"N11\": \"14055.74\", \"A12\": \"Subscriptions\", \"B12\": \"415.15\", \"C12\": \"404.51\", \"D12\": \"567.39\", \"E12\": \"1286.79\", \"F12\": \"540.25\", \"G12\": \"1824.46\", \"H12\": \"666.17\", \"I12\": \"1443.60\", \"J12\": \"1824.72\", \"K12\": \"919.64\", \"L12\": \"1529.23\", \"M12\": \"559.13\", \"N12\": \"11981.04\", \"A13\": \"Miscellaneous\", \"B13\": \"1031.98\", \"C13\": \"101.70\", \"D13\": \"1201.97\", \"E13\": \"952.49\", \"F13\": \"1590.41\", \"G13\": \"385.46\", \"H13\": \"1544.89\", \"I13\": \"1999.33\", \"J13\": \"1949.46\", \"K13\": \"1270.66\", \"L13\": \"1448.82\", \"M13\": \"1084.73\", \"N13\": \"14561.90\", \"A14\": \"Total\", \"B14\": \"=sum(B2:B13)\", \"C14\": \"=sum(C2:C13)\", \"D14\": \"=sum(D2:D13)\", \"E14\": \"=sum(E2:E13)\", \"F14\": \"=sum(F2:F13)\", \"G14\": \"=sum(G2:G13)\", \"H14\": \"=sum(H2:H13)\", \"I14\": \"=sum(I2:I13)\", \"J14\": \"=sum(J2:J13)\", \"K14\": \"=sum(K2:K13)\", \"L14\": \"=sum(L2:L13)\", \"M14\": \"=sum(M2:M13)\", \"N14\": \"=sum(N2:N13)\"}}], \"active\": \"Budget\"}"
