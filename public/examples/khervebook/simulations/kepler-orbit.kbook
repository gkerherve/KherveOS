  {
   "type": "markdown",
   "source": "# Kepler Orbit\nA planet on an eccentric orbit — faster near the star (equal areas in equal times). Stop with the red button."
  },
  {
   "type": "code",
   "source": "# Kepler orbit — runs continuously\nif 'kp_pos' not in globals():\n    kp_pos = np.array([1.5, 0.0])\n    kp_vel = np.array([0.0, 0.65])\n    kp_trace = []\nfor _ in range(6):                  # leapfrog substeps\n    h = 0.01\n    r = np.linalg.norm(kp_pos)\n    kp_vel = kp_vel - h * kp_pos / r**3\n    kp_pos = kp_pos + h * kp_vel\nkp_trace = (kp_trace + [tuple(kp_pos)])[-500:]\nfig, ax = plt.subplots(figsize=(4.4, 4.4))\ntr = np.array(kp_trace)\nax.plot(tr[:, 0], tr[:, 1], lw=0.7, alpha=0.7)\nax.plot(0, 0, '*', color='#f6b73c', ms=22)\nax.plot(*kp_pos, 'o', color='#2176c7', ms=9)\nax.set_xlim(-2, 2); ax.set_ylim(-2, 2)\nax.set_aspect('equal'); ax.set_xticks([]); ax.set_yticks([])\nfig"
  }
 ]
}