   "type": "markdown",
   "source": "# Employee Directory\nA randomly generated staff list."
  },
  {
   "type": "sheet",
   "source": "{\"sheets\": [{\"name\": \"Employees\", \"rows\": 21, \"cols\": 6, \"data\": {\"A1\": \"ID\", \"B1\": \"Name\", \"C1\": \"Department\", \"D1\": \"Position\", \"E1\": \"Salary\", \"F1\": \"Start Date\", \"A2\": \"1001\", \"B2\": \"Emma Martinez\", \"C2\": \"Engineering\", \"D2\": \"Staff\", \"E2\": \"95432\", \"F2\": \"2021-10-01\", \"A3\": \"1002\", \"B3\": \"Maria Martinez\", \"C3\": \"Sales\", \"D3\": \"Staff\", \"E3\": \"117512\", \"F3\": \"2015-11-01\", \"A4\": \"1003\", \"B4\": \"David Miller\", \"C4\": \"Sales\", \"D4\": \"Staff\", \"E4\": \"145741\", \"F4\": \"2020-02-01\", \"A5\": \"1004\", \"B5\": \"David Martinez\", \"C5\": \"Marketing\", \"D5\": \"Staff\", \"E5\": \"104470\", \"F5\": \"2015-12-01\", \"A6\": \"1005\", \"B6\": \"David Martinez\", \"C6\": \"Marketing\", \"D6\": \"Staff\", \"E6\": \"111542\", \"F6\": \"2016-11-01\", \"A7\": \"1006\", \"B7\": \"John Martinez\", \"C7\": \"Finance\", \"D7\": \"Staff\", \"E7\": \"71071\", \"F7\": \"2017-06-01\", \"A8\": \"1007\", \"B8\": \"Emma Smith\", \"C8\": \"Finance\", \"D8\": \"Staff\", \"E8\": \"45074\", \"F8\": \"2024-06-01\", \"A9\": \"1008\", \"B9\": \"James Brown\", \"C9\": \"Engineering\", \"D9\": \"Staff\", \"E9\": \"92576\", \"F9\": \"2019-04-01\", \"A10\": \"1009\", \"B10\": \"Emma Johnson\", \"C10\": \"Finance\", \"D10\": \"Staff\", \"E10\": \"55322\", \"F10\": \"2016-12-01\", \"A11\": \"1010\", \"B11\": \"Emma Martinez\", \"C11\": \"Finance\", \"D11\": \"Staff\", \"E11\": \"145379\", \"F11\": \"2017-03-01\", \"A12\": \"1011\", \"B12\": \"Michael Brown\", \"C12\": \"Marketing\", \"D12\": \"Staff\", \"E12\": \"79741\", \"F12\": \"2023-10-01\", \"A13\": \"1012\", \"B13\": \"David Miller\", \"C13\": \"Finance\", \"D13\": \"Staff\", \"E13\": \"143994\", \"F13\": \"2018-12-01\", \"A14\": \"1013\", \"B14\": \"Robert Davis\", \"C14\": \"Operations\", \"D14\": \"Staff\", \"E14\": \"130180\", \"F14\": \"2020-08-01\", \"A15\": \"1014\", \"B15\": \"Lisa Smith\", \"C15\": \"Engineering\", \"D15\": \"Staff\", \"E15\": \"77493\", \"F15\": \"2018-02-01\", \"A16\": \"1015\", \"B16\": \"Sara Smith\", \"C16\": \"Finance\", \"D16\": \"Staff\", \"E16\": \"117603\", \"F16\": \"2018-10-01\", \"A17\": \"1016\", \"B17\": \"Maria Smith\", \"C17\": \"Engineering\", \"D17\": \"Staff\", \"E17\": \"137778\", \"F17\": \"2015-04-01\", \"A18\": \"1017\", \"B18\": \"David Davis\", \"C18\": \"Sales\", \"D18\": \"Staff\", \"E18\": \"54287\", \"F18\": \"2023-04-01\", \"A19\": \"1018\", \"B19\": \"Olivia Wilson\", \"C19\": \"Marketing\", \"D19\": \"Staff\", \"E19\": \"115678\", \"F19\": \"2017-12-01\", \"A20\": \"1019\", \"B20\": \"Sara Johnson\", \"C20\": \"HR\", \"D20\": \"Staff\", \"E20\": \"76850\", \"F20\": \"2022-07-01\", \"A21\": \"1020\", \"B21\": \"Michael Miller\", \"C21\": \"Engineering\", \"D21\": \"Staff\", \"E21\": \"131374\", \"F21\": \"2021-06-01\"}}], \"active\": \"Employees\"}"
  },
  {
   "type": "code",
   "source": "\n# Auto-chart of the sheet's numeric columns (reads the live sheet1 grid).\nimport numpy as np\nimport matplotlib.pyplot as plt\n\ngrid = [list(r) for r in sheet1]\nhdr = grid[0] if grid else []\nrows = grid[1:] if len(grid) > 1 else []\nwhile rows and all(c in (None, \"\") for c in rows[-1]):   # drop blank padding\n    rows.pop()\nncol = max((len(r) for r in grid), default=0)\n\n\ndef _col(j):\n    out = []\n    for r in rows:\n        try:\n            out.append(float(str(r[j]).replace(\",\", \"\")))\n        except Exception:\n            out.append(np.nan)\n    return np.array(out, dtype=float)\n\n\nnum = [j for j in range(ncol)\n       if np.isfinite(_col(j)).sum() >= max(2, 0.4 * len(rows))]\nlabel_j = next((j for j in range(ncol) if j not in num), None)\nseries = [j for j in num if j != label_j][:3] or num[:3]\n\nfig, ax = plt.subplots(figsize=(6, 4))\nif not series:\n    ax.text(0.5, 0.5, \"no numeric columns to chart\",\n            ha=\"center\", va=\"center\", color=\"0.5\")\n    ax.axis(\"off\")\nelif label_j is not None and len(rows) <= 16:\n    labels = [str(r[label_j]) for r in rows]\n    x = np.arange(len(rows))\n    w = 0.8 / len(series)\n    for k, j in enumerate(series):\n        ax.bar(x + k * w, np.nan_to_num(_col(j)), w,\n               label=str(hdr[j]) if j < len(hdr) else \"\")\n    ax.set_xticks(x + 0.4 - w / 2)\n    ax.set_xticklabels(labels, rotation=45, ha=\"right\", fontsize=8)\n    if len(series) > 1:\n        ax.legend(fontsize=8)\nelif label_j is None and len(series) == 1:\n    ax.plot(np.arange(len(rows)), _col(series[0]), color=\"#3776ab\")\nelse:\n    xj = None if label_j is not None else series[0]\n    ys = [j for j in series if j != xj]\n    xv = np.arange(len(rows)) if xj is None else _col(xj)\n    for j in ys:\n        ax.plot(xv, _col(j), label=str(hdr[j]) if j < len(hdr) else \"\")\n    if xj is not None and xj < len(hdr):\n        ax.set_xlabel(str(hdr[xj]))\n    ax.legend(fontsize=8)\nif series:\n    ax.set_title(\"Employee Directory\")\n    ax.grid(True, alpha=0.3)\nfig.tight_layout()\nfig\n"
  },
  {
   "type": "svg",
   "source": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 240 150\" width=\"240\" height=\"150\"><rect width=\"240\" height=\"150\" rx=\"12\" fill=\"#f4f7fb\"/><g fill=\"#3776ab\"><rect x=\"48\" y=\"100\" width=\"26\" height=\"30\"/><rect x=\"84\" y=\"80\" width=\"26\" height=\"50\"/><rect x=\"120\" y=\"58\" width=\"26\" height=\"72\"/><rect x=\"156\" y=\"40\" width=\"26\" height=\"90\"/></g><polyline points=\"61,95 97,75 133,53 169,35\" fill=\"none\" stroke=\"#e07b39\" stroke-width=\"3\"/><line x1=\"40\" y1=\"130\" x2=\"198\" y2=\"130\" stroke=\"#2e3440\" stroke-width=\"2\"/></svg>"
  }
 ]
