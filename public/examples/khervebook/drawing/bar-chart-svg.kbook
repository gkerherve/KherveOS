  {
   "type": "markdown",
   "source": "# SVG Bar Chart\nA bar chart assembled from `<rect>` bars, `<line>` axes and gridlines, and `<text>` labels — no plotting library, just SVG."
  },
  {
   "type": "svg",
   "source": "<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" viewBox=\"0 0 480 320\" width=\"480\" height=\"320\">\n  <rect x=\"0\" y=\"0\" width=\"480\" height=\"320\" fill=\"#ffffff\"/>\n  <defs><linearGradient id=\"barFill\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#e07b39\"/><stop offset=\"1\" stop-color=\"#3776ab\"/></linearGradient></defs>\n  <text x=\"240\" y=\"30\" font-family=\"sans-serif\" font-size=\"18\" font-weight=\"bold\" fill=\"#2e3440\" text-anchor=\"middle\">Weekly visitors</text>\n  <line x1=\"50\" y1=\"264.0\" x2=\"456\" y2=\"264.0\" stroke=\"#e3e8ef\" stroke-width=\"1\"/>\n  <text x=\"42\" y=\"268.0\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#7a8699\" text-anchor=\"end\">0</text>\n  <line x1=\"50\" y1=\"210.5\" x2=\"456\" y2=\"210.5\" stroke=\"#e3e8ef\" stroke-width=\"1\"/>\n  <text x=\"42\" y=\"214.5\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#7a8699\" text-anchor=\"end\">20</text>\n  <line x1=\"50\" y1=\"157.0\" x2=\"456\" y2=\"157.0\" stroke=\"#e3e8ef\" stroke-width=\"1\"/>\n  <text x=\"42\" y=\"161.0\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#7a8699\" text-anchor=\"end\">40</text>\n  <line x1=\"50\" y1=\"103.5\" x2=\"456\" y2=\"103.5\" stroke=\"#e3e8ef\" stroke-width=\"1\"/>\n  <text x=\"42\" y=\"107.5\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#7a8699\" text-anchor=\"end\">60</text>\n  <line x1=\"50\" y1=\"50.0\" x2=\"456\" y2=\"50.0\" stroke=\"#e3e8ef\" stroke-width=\"1\"/>\n  <text x=\"42\" y=\"54.0\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#7a8699\" text-anchor=\"end\">80</text>\n  <line x1=\"50\" y1=\"50\" x2=\"50\" y2=\"264\" stroke=\"#2e3440\" stroke-width=\"1.5\"/>\n  <line x1=\"50\" y1=\"264\" x2=\"456\" y2=\"264\" stroke=\"#2e3440\" stroke-width=\"1.5\"/>\n  <rect x=\"61.6\" y=\"151.7\" width=\"34.8\" height=\"112.3\" rx=\"3\" fill=\"url(#barFill)\"/>\n  <text x=\"79.0\" y=\"145.7\" font-family=\"sans-serif\" font-size=\"11\" font-weight=\"bold\" fill=\"#2e3440\" text-anchor=\"middle\">42</text>\n  <text x=\"79.0\" y=\"282\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#52606d\" text-anchor=\"middle\">Mon</text>\n  <rect x=\"119.6\" y=\"108.8\" width=\"34.8\" height=\"155.2\" rx=\"3\" fill=\"url(#barFill)\"/>\n  <text x=\"137.0\" y=\"102.8\" font-family=\"sans-serif\" font-size=\"11\" font-weight=\"bold\" fill=\"#2e3440\" text-anchor=\"middle\">58</text>\n  <text x=\"137.0\" y=\"282\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#52606d\" text-anchor=\"middle\">Tue</text>\n  <rect x=\"177.6\" y=\"170.4\" width=\"34.8\" height=\"93.6\" rx=\"3\" fill=\"url(#barFill)\"/>\n  <text x=\"195.0\" y=\"164.4\" font-family=\"sans-serif\" font-size=\"11\" font-weight=\"bold\" fill=\"#2e3440\" text-anchor=\"middle\">35</text>\n  <text x=\"195.0\" y=\"282\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#52606d\" text-anchor=\"middle\">Wed</text>\n  <rect x=\"235.6\" y=\"74.1\" width=\"34.8\" height=\"189.9\" rx=\"3\" fill=\"url(#barFill)\"/>\n  <text x=\"253.0\" y=\"68.1\" font-family=\"sans-serif\" font-size=\"11\" font-weight=\"bold\" fill=\"#2e3440\" text-anchor=\"middle\">71</text>\n  <text x=\"253.0\" y=\"282\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#52606d\" text-anchor=\"middle\">Thu</text>\n  <rect x=\"293.6\" y=\"92.8\" width=\"34.8\" height=\"171.2\" rx=\"3\" fill=\"url(#barFill)\"/>\n  <text x=\"311.0\" y=\"86.8\" font-family=\"sans-serif\" font-size=\"11\" font-weight=\"bold\" fill=\"#2e3440\" text-anchor=\"middle\">64</text>\n  <text x=\"311.0\" y=\"282\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#52606d\" text-anchor=\"middle\">Fri</text>\n  <rect x=\"351.6\" y=\"132.9\" width=\"34.8\" height=\"131.1\" rx=\"3\" fill=\"url(#barFill)\"/>\n  <text x=\"369.0\" y=\"126.9\" font-family=\"sans-serif\" font-size=\"11\" font-weight=\"bold\" fill=\"#2e3440\" text-anchor=\"middle\">49</text>\n  <text x=\"369.0\" y=\"282\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#52606d\" text-anchor=\"middle\">Sat</text>\n  <rect x=\"409.6\" y=\"183.8\" width=\"34.8\" height=\"80.2\" rx=\"3\" fill=\"url(#barFill)\"/>\n  <text x=\"427.0\" y=\"177.8\" font-family=\"sans-serif\" font-size=\"11\" font-weight=\"bold\" fill=\"#2e3440\" text-anchor=\"middle\">30</text>\n  <text x=\"427.0\" y=\"282\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#52606d\" text-anchor=\"middle\">Sun</text>\n</svg>"
  }
 ]
