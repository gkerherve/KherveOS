  {
   "type": "code",
   "source": "rows = sheet1[1:]\ndeg = [float(r[0]) for r in rows]\nfig, ax = plt.subplots()\nax.plot(deg, [float(r[2]) for r in rows], label='sin')\nax.plot(deg, [float(r[3]) for r in rows], label='cos')\nax.set_xlabel('angle (deg)'); ax.legend()\nax.set_title('Sine and cosine')\nfig"
