 "format": "kbook",
 "version": 1,
 "cells": [
  {
   "type": "markdown",
   "source": "# Central Limit Theorem\nMeans of uniform samples become Gaussian as n grows."
  },
  {
   "type": "code",
   "source": "rng = np.random.default_rng(0)\nfig, axes = plt.subplots(1, 3, figsize=(8.5, 2.8))\nfor ax, n in zip(axes, (1, 5, 30)):\n    means = rng.random((20000, n)).mean(axis=1)\n    ax.hist(means, bins=60, density=True)\n    ax.set_title(f'n = {n}')\nfig.tight_layout()\nfig"
  }
 ]
}