   "source": "# Maxwell's Equations\nThe four equations of classical electromagnetism, in differential form (SI units). Each **latex cell** renders a single display equation instantly with matplotlib mathtext — double-click a rendered equation to edit its source, then run (Shift+Enter)."
  },
  {
   "type": "latex",
   "source": "\\nabla \\cdot \\vec{E} = \\frac{\\rho}{\\varepsilon_0}"
  },
  {
   "type": "latex",
   "source": "\\nabla \\cdot \\vec{B} = 0"
  },
  {
   "type": "latex",
   "source": "\\nabla \\times \\vec{E} = -\\frac{\\partial \\vec{B}}{\\partial t}"
  },
  {
   "type": "latex",
   "source": "\\nabla \\times \\vec{B} = \\mu_0 \\vec{J} + \\mu_0 \\varepsilon_0 \\frac{\\partial \\vec{E}}{\\partial t}"
  }
