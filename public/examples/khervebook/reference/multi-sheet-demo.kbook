   "type": "code",
   "source": "rows = sheet1[1:]\nx = [float(r[0]) for r in rows]\nfig, ax = plt.subplots()\nax.plot(x, [float(r[1]) for r in rows], label='Y1 = sin x')\nax.plot(x, [float(r[2]) for r in rows], label='Y2 = cos x')\nax.legend(); ax.set_xlabel('X')\nax.set_title('The Data sheet, plotted')\nfig"
