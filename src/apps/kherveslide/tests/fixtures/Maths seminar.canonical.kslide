    },
    {
      "objects": [
        {
          "x": 0.06,
          "y": 0.22,
          "w": 0.88,
          "h": 0.1,
          "text": "$f(x) = e^{-x^2}$ is integrable on $\\mathbb{R}$.",
          "font_pt": 15,
          "font_family": "",
          "color": "#000000",
          "fill": "",
          "fill2": "",
          "gradient": "vertical",
          "align": "left",
          "bold": false,
          "italic": false,
          "border_color": "",
          "border_width": 1.0,
          "corner": "sharp",
          "border_style": "solid",
          "fill_opacity": 1.0,
          "shadow": false,
          "corner_radius": 4.0,
          "locked": false,
          "block": "definition",
          "block_title": "",
          "group": 0,
          "type": "SlideText"
        },
        {
          "x": 0.06,
          "y": 0.4,
          "w": 0.88,
          "h": 0.22,
          "text": "\\[\\int_{-\\infty}^{\\infty} e^{-x^2}\\,dx = \\sqrt{\\pi}\\]",
          "font_pt": 18,
          "font_family": "",
          "color": "#000000",
          "fill": "",
          "fill2": "",
          "gradient": "vertical",
          "align": "left",
          "bold": false,
          "italic": false,
          "border_color": "",
          "border_width": 1.0,
          "corner": "sharp",
          "border_style": "solid",
          "fill_opacity": 1.0,
          "shadow": false,
          "corner_radius": 4.0,
          "locked": false,
          "block": "theorem",
          "block_title": "Gauss",
          "group": 0,
          "type": "SlideText"
        },
        {
          "x": 0.06,
          "y": 0.74,
          "w": 0.88,
          "h": 0.1,
          "text": "Square it, then switch to polar coordinates.",
          "font_pt": 15,
          "font_family": "",
          "color": "#000000",
          "fill": "",
          "fill2": "",
          "gradient": "vertical",
          "align": "left",
          "bold": false,
          "italic": false,
          "border_color": "",
          "border_width": 1.0,
          "corner": "sharp",
          "border_style": "solid",
          "fill_opacity": 1.0,
          "shadow": false,
          "corner_radius": 4.0,
          "locked": false,
          "block": "proof",
          "block_title": "",
          "group": 0,
          "type": "SlideText"
        }
      ],
      "title": "Statement",
      "bg": "",
      "bg_alpha": 1.0,
      "free": true,
      "type": "Slide",
      "hidden": false
    },
    {
      "objects": [
        {
          "x": 0.04,
          "y": 0.2,
          "w": 0.66,
          "h": 0.15,
          "text": "\\[I^2 = \\int\\int e^{-(x^2+y^2)}\\,dx\\,dy\\]",
          "font_pt": 22,
          "font_family": "",
          "color": "#000000",
          "fill": "",
          "fill2": "",
          "gradient": "vertical",
          "align": "center",
          "bold": false,
          "italic": false,
          "border_color": "",
          "border_width": 1.0,
          "corner": "sharp",
          "border_style": "solid",
          "fill_opacity": 1.0,
          "shadow": false,
          "corner_radius": 4.0,
          "locked": false,
          "block": "",
          "block_title": "",
          "group": 0,
          "type": "SlideText"
        },
        {
          "x": 0.74,
          "y": 0.24000000000000002,
          "w": 0.22,
          "h": 0.08,
          "text": "\\textit{square}",
          "font_pt": 15,
          "font_family": "",
          "color": "#666666",
          "fill": "",
          "fill2": "",
          "gradient": "vertical",
          "align": "left",
          "bold": false,
          "italic": false,
          "border_color": "",
          "border_width": 1.0,
          "corner": "sharp",
          "border_style": "solid",
          "fill_opacity": 1.0,
          "shadow": false,
          "corner_radius": 4.0,
          "locked": false,
          "block": "",
          "block_title": "",
          "group": 0,
          "type": "SlideText"
        },
        {
          "x": 0.04,
          "y": 0.39,
          "w": 0.66,
          "h": 0.15,
          "text": "\\[= \\int_0^{2\\pi}\\int_0^{\\infty} e^{-r^2}\\,r\\,dr\\,d\\theta\\]",
          "font_pt": 22,
          "font_family": "",
          "color": "#000000",
          "fill": "",
          "fill2": "",
          "gradient": "vertical",
          "align": "center",
          "bold": false,
          "italic": false,
          "border_color": "",
          "border_width": 1.0,
          "corner": "sharp",
          "border_style": "solid",
          "fill_opacity": 1.0,
          "shadow": false,
          "corner_radius": 4.0,
          "locked": false,
          "block": "",
          "block_title": "",
          "group": 0,
          "type": "SlideText"
        },
        {
          "x": 0.74,
          "y": 0.43,
          "w": 0.22,
          "h": 0.08,
          "text": "\\textit{polar}",
          "font_pt": 15,
          "font_family": "",
          "color": "#666666",
          "fill": "",
          "fill2": "",
          "gradient": "vertical",
          "align": "left",
          "bold": false,
          "italic": false,
          "border_color": "",
          "border_width": 1.0,
          "corner": "sharp",
          "border_style": "solid",
          "fill_opacity": 1.0,
          "shadow": false,
          "corner_radius": 4.0,
          "locked": false,
          "block": "",
          "block_title": "",
          "group": 0,
          "type": "SlideText"
        },
        {
          "x": 0.04,
          "y": 0.5800000000000001,
          "w": 0.66,
          "h": 0.15,
          "text": "\\[= 2\\pi \\cdot \\frac{1}{2} = \\pi\\]",
          "font_pt": 22,
          "font_family": "",
          "color": "#000000",
          "fill": "",
          "fill2": "",
          "gradient": "vertical",
          "align": "center",
          "bold": false,
          "italic": false,
          "border_color": "",
          "border_width": 1.0,
          "corner": "sharp",
          "border_style": "solid",
          "fill_opacity": 1.0,
          "shadow": false,
          "corner_radius": 4.0,
          "locked": false,
          "block": "",
          "block_title": "",
          "group": 0,
          "type": "SlideText"
        },
        {
          "x": 0.74,
          "y": 0.6200000000000001,
          "w": 0.22,
          "h": 0.08,
          "text": "\\textit{integrate}",
          "font_pt": 15,
          "font_family": "",
          "color": "#666666",
          "fill": "",
          "fill2": "",
          "gradient": "vertical",
          "align": "left",
          "bold": false,
          "italic": false,
          "border_color": "",
          "border_width": 1.0,
          "corner": "sharp",
          "border_style": "solid",
          "fill_opacity": 1.0,
          "shadow": false,
          "corner_radius": 4.0,
          "locked": false,
          "block": "",
          "block_title": "",
          "group": 0,
          "type": "SlideText"
        },
        {
          "x": 0.04,
          "y": 0.84,
          "w": 0.9,
          "h": 0.08,
          "text": "Hence $I = \\sqrt{\\pi}$.",
          "font_pt": 18,
          "font_family": "",
          "color": "#002147",
          "fill": "",
          "fill2": "",
          "gradient": "vertical",
          "align": "center",
          "bold": true,
          "italic": false,
          "border_color": "",
          "border_width": 1.0,
          "corner": "sharp",
          "border_style": "solid",
          "fill_opacity": 1.0,
          "shadow": false,
          "corner_radius": 4.0,
          "locked": false,
          "block": "",
          "block_title": "",
          "group": 0,
          "type": "SlideText"
        }
      ],
      "title": "Proof by polar coordinates",
