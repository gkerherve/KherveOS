        },
        {
          "x": 0.52,
          "y": 0.26,
          "w": 0.44,
          "h": 0.5,
          "text": "\\begin{itemize}\n\\item The integrand depends on $r$ only\n\\item Rings of radius $r$ have length $2\\pi r$\n\\item That extra $r$ makes it integrable\n\\end{itemize}",
          "font_pt": 16,
          "font_family": "",
          "color": "#000000",
          "fill": "",
          "fill2": "",
          "gradient": "vertical",
