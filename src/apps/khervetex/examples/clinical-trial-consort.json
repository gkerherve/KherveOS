    },
    {
      "children": [
        {
          "text": "The number needed to treat for one participant to reach HbA1c < 7 % was ",
          "marks": [],
          "type": "Text"
        },
        {
          "latex": "\\text{NNT} = 1/\\text{ARR} = 1/(0.31-0.12) \\approx 5",
          "type": "MathInline"
        },
        {
          "text": ".",
          "marks": [],
          "type": "Text"
        }
      ],
      "alignment": "justify",
      "type": "Paragraph"
    },
    {
      "level": 1,
      "children": [
        {
          "text": "Discussion",
          "marks": [],
          "type": "Text"
        }
      ],
      "numbered": true,
      "label": null,
      "type": "Section"
    },
    {
      "children": [
        {
          "text": "The observed effect exceeds the 0.3–0.4 % threshold usually considered clinically relevant. Limitations include the short follow-up and the impossibility of blinding participants.",
          "marks": [],
          "type": "Text"
        }
      ],
      "alignment": "justify",
      "type": "Paragraph"
    },
