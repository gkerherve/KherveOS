    },
    {
      "children": [
        {
          "text": "The achemso class is maintained on CTAN and mirrors the ACS submission guidelines. It automatically loads natbib and sets the bibliography style to match the target journal. Common target journals can be set in the preamble with ",
          "marks": [],
          "type": "Text"
        },
        {
          "text": "\\journal{abbreviation}",
          "marks": [
            "code"
          ],
          "type": "Text"
        },
        {
          "text": ".",
          "marks": [],
          "type": "Text"
        }
