    {
      "level": 1,
      "children": [
        {
          "text": "Decision requested",
          "marks": [],
          "type": "Text"
        }
      ],
      "numbered": true,
      "label": null,
      "type": "Section"
    },
    {
      "children": [
        {
          "text": "Please confirm by 28 May whether the 7 June window is acceptable, or suggest an alternative date. If there are no objections by that date we will proceed as described above.",
          "marks": [],
          "type": "Text"
        }
      ],
